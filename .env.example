# HRM — configuración segura de desarrollo
PAPER_MODE=true
BINANCE_MODE=paper
HRM_ENABLE_LIVE_TRADING=false
INITIAL_CAPITAL=3000

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Opcionales
NEWS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
FRED_API_KEY=
USE_ONLINE_SOURCES=false

# Orígenes permitidos para el frontend Vite
HRM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Avanzadas (todas opcionales; comentadas = se usa el valor por defecto del código) ---
# Sobrescriben valores de core/config.py. NO activar HRM_PAPER_MODE=false: desactiva PAPER en esa capa.
